/* pages/about/about.wxss */
.about-card {
  width: 100%;
}

.about-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #8B4513;
  text-align: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #E8D5C0;
}

.about-section {
  margin-bottom: 24rpx;
}

.about-heading {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #A0522D;
  margin-bottom: 8rpx;
}

.about-text {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
}

.about-list {
  display: flex;
  flex-direction: column;
  margin-top: 12rpx;
}

.about-list text {
  font-size: 26rpx;
  color: #555;
  line-height: 2;
}
